# Safe default: no lab devices or credentials are needed in MOCK.
SENTRIX_MODE=MOCK
SENTRIX_DB_PATH=sentrix.db
SENTRIX_LAB_CONFIG=lab-config.json

# Set only for a dedicated, authorized lab. Never commit the populated values.
# SENTRIX_LAB_USERNAME=
# SENTRIX_LAB_PASSWORD=
# SENTRIX_LIVE_CHANGE_TOKEN=
# SENTRIX_APPROVAL_TOKEN=  # Separate token for critical-asset decisions
